# ShortForge 환경 설정 — 이 파일을 .env로 복사해서 값을 채운다.
# 필수 키는 2개뿐이다 (YOUTUBE_API_KEY, GEMINI_API_KEY). LLM_MODE=ollama면 GEMINI_API_KEY는 비워도 된다.

# S2 레퍼런스 탐색 — Google Cloud Console > YouTube Data API v3 > 사용자 인증 정보 > API 키
YOUTUBE_API_KEY=

# S1/S3/S4/S6 LLM — Google AI Studio (https://aistudio.google.com/apikey)
# 반드시 결제(billing)가 연결되지 않은 프로젝트의 키를 쓴다. 결제가 연결되면 유료 등급이 되어 모든 호출이 과금된다
GEMINI_API_KEY=
# 버전을 고정한 이름을 쓴다 (gemini-flash-latest 같은 별칭은 대상이 바뀐다)
GEMINI_MODEL=gemini-3.8-flash
# 가벼운 작업(S1·S2 관련성·S6)용 경량 모델. 무료 등급 일일 한도는 모델마다 따로다 (3.8-flash는 하루 20회)
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# 주 모델(S3 요인·S4 전략)의 사고 수준: minimal | low | medium | high. 비우면 모델 기본값(느리다)
# low는 S3·S4 요청이 약 2배 빠르고 품질 Gate를 통과했다 (2026-10-19)
GEMINI_THINKING_LEVEL=low

# ── 고급 모드 (선택, 유료, D13) ───────────────────────────
# off면 지금과 같다(비용 ₩0). 켜면 ADVANCED_TASKS의 작업만 사용자 키로 유료 모델을 쓰고,
# 나머지는 무료 Gemini가 맡는다. 하루 예산을 넘거나 실패하면 무료 경로로 돌아간다.
# 웹 UI 설정 화면의 "고급 모드"에서 켜는 것을 권한다(과금 동의·키 확인을 거친다).
# off | anthropic | openai | openrouter
LLM_ADVANCED=off
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter: 키 하나로 Claude·GPT 등. 충전한 크레딧에서 차감된다
OPENROUTER_API_KEY=
# 비우면 실측으로 정한 추천 모델(Anthropic·OpenRouter: Claude Sonnet 5.5, OpenAI: GPT-5.6 Sol).
# 고를 수 있는 모델과 가격은 backend/app/spend.py
ADVANCED_MODEL=
ADVANCED_TASKS=s3_factors,s4_strategy
# low | medium | high — 높을수록 깊이 생각하고 느리며 비싸다
ADVANCED_EFFORT=medium
# 하루(UTC) 예산 상한, 미국 달러
ADVANCED_DAILY_BUDGET_USD=1.00

# ── 영상 만들기 (선택, 유료, D19) ─────────────────────────
# off면 비용이 들지 않는다. hf면 다듬기 화면에 장면 그림을 영상으로 바꾸는 버튼이 생기고,
# 누른 장면만 사용자의 Hugging Face 크레딧을 쓴다 (1초에 약 $0.018, 하루 예산을 넘으면 멈춘다).
# 웹 UI 설정 화면의 "영상 만들기"에서 켜는 것을 권한다(과금 동의·토큰 확인을 거친다).
# 토큰: huggingface.co/settings/tokens → 'Make calls to Inference Providers' 권한
VIDEO_GEN=off
HF_TOKEN=
VIDEO_GEN_DAILY_BUDGET_USD=1.00

# LLM 엔진 선택: gemini | ollama
LLM_MODE=gemini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 이미지 소스를 시도 순서대로 (D12). 본인 사진이 있는 장면은 항상 사진을 먼저 쓴다.
#   upload               생성하지 않음 (사진 + 프롬프트 내보내기)
#   cloudflare,stock     Cloudflare 무료 AI 생성 → 한도 초과·실패 시 Pixabay 무료 사진
#   comfyui              원격 GPU 장비의 ComfyUI
IMAGE_MODE=upload

# Cloudflare Workers AI (무료: 하루 10,000 Neurons ≈ 9:16 이미지 64장, 00:00 UTC 초기화)
# dash.cloudflare.com → 계정 ID 복사 / 내 프로필 → API 토큰 → "Workers AI" 템플릿으로 생성
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Pexels 무료 사진 (IMAGE_MODE에 pexels를 쓸 때만. 2026-10 현재 신규 키 발급 중단)
PEXELS_API_KEY=

# Pixabay 무료 사진 (pixabay.com 가입 → 로그인 → pixabay.com/api/docs/ 의 key 값). 60초당 100회
PIXABAY_API_KEY=
COMFYUI_URL=
# 비우면 기본 SDXL txt2img 템플릿. FLUX 등은 ComfyUI "Save (API Format)" JSON 경로 ({{prompt}} {{negative}} {{seed}} {{width}} {{height}})
COMFYUI_WORKFLOW=

# TTS 엔진: edge | melo
TTS_MODE=edge
TTS_VOICE=ko-KR-SunHiNeural

# S6: LLM이 장면 연출(모션·전환·자막 스타일)을 고른다. false면 규칙 기반만 (LLM 호출 1회 절약)
S6_USE_LLM=true
# S6 배경음악: auto = 내용에 맞는 분위기(잔잔한·경쾌한·벅차오르는 등)를 골라 이 PC에서 합성 (비용·저작권 걱정 없음)
# off = 음악 없이. 화면(6단계)에서 분위기 바꾸기·끄기·내 음악 올리기를 할 수 있다
BGM_MODE=auto

# 해외 레퍼런스 시장 "언어:지역" (앞의 2개만 쓴다. 비우면 입력의 지역만 찾는다)
SEARCH_MARKETS=en:US,ja:JP

# S7 렌더 (FFmpeg). veryfast: 30초 영상 약 35~47초(i5-8265U), medium은 약 3배 느림
RENDER_PRESET=veryfast
# 0 = CPU 코어 수의 절반만큼 장면 클립을 병렬 인코딩
RENDER_WORKERS=0
# true = 다듬는 동안 바뀐 장면 클립을 뒤에서 미리 만든다(완성이 2~3배 빠르다, CPU를 쓴다). 설정 화면에서도 바꿀 수 있다
PRERENDER_CLIPS=false
# auto = 설치된 글꼴 중 Pretendard → Noto Sans KR → 나눔고딕 → 맑은 고딕 순서로 고른다
SUBTITLE_FONT=auto
# 렌더 색 보정: film(대비·따뜻한 톤·비네팅·약한 그레인) | clean | off
RENDER_GRADE=film
# 영상 끝 엔딩 카드에 넣을 채널 이름 (예: @mychannel). 비우면 엔딩 카드 없음
BRAND_NAME=

# YouTube 쿼터 보호 (units/일). 이 값을 넘으면 search.list를 차단한다.
YOUTUBE_DAILY_UNIT_LIMIT=8000

# 레퍼런스 영상 최대 길이(초). Shorts는 최대 180초까지 가능하지만 MVP 기본값은 60초.
REF_MAX_DURATION_SEC=60

# 웹 UI
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# 개발용: LLM만 Fake (Gemini 키 없이 UI 개발). 운영에서는 false
DEV_FAKE_LLM=false

# 런타임 데이터 위치
DATA_DIR=./data
