# ShortForge 환경 설정 — 이 파일을 .env로 복사해서 값을 채운다.
# 필수 키는 2개뿐이다 (YOUTUBE_API_KEY, GEMINI_API_KEY). LLM_MODE=ollama면 GEMINI_API_KEY는 비워도 된다.

# S2 레퍼런스 탐색 — Google Cloud Console > YouTube Data API v3 > 사용자 인증 정보 > API 키
YOUTUBE_API_KEY=

# S1/S3/S4/S6 LLM — Google AI Studio (https://aistudio.google.com/apikey)
# 반드시 결제(billing)가 연결되지 않은 프로젝트의 키를 쓴다. 결제가 연결되면 유료 등급이 되어 모든 호출이 과금된다
GEMINI_API_KEY=
# 버전을 고정한 이름을 쓴다 (gemini-flash-latest 같은 별칭은 대상이 바뀐다)
GEMINI_MODEL=gemini-3.8-flash
# 가벼운 작업(S1·S2 관련성·S6)용 경량 모델. 무료 등급 일일 한도는 모델마다 따로다 (3.8-flash는 하루 20회)
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# LLM 엔진 선택: gemini | ollama
LLM_MODE=gemini
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 이미지 경로: upload(기본, 본인 사진 + 프롬프트 내보내기) | comfyui(원격 GPU 장비)
IMAGE_MODE=upload
COMFYUI_URL=
# 비우면 기본 SDXL txt2img 템플릿. FLUX 등은 ComfyUI "Save (API Format)" JSON 경로 ({{prompt}} {{negative}} {{seed}} {{width}} {{height}})
COMFYUI_WORKFLOW=

# TTS 엔진: edge | melo
TTS_MODE=edge
TTS_VOICE=ko-KR-SunHiNeural

# S6: LLM이 장면 연출(모션·전환·자막 스타일)을 고른다. false면 규칙 기반만 (LLM 호출 1회 절약)
S6_USE_LLM=true

# S7 렌더 (FFmpeg). veryfast: 30초 영상 약 35~47초(i5-8265U), medium은 약 3배 느림
RENDER_PRESET=veryfast
# 0 = CPU 코어 수의 절반만큼 장면 클립을 병렬 인코딩
RENDER_WORKERS=0
SUBTITLE_FONT=Malgun Gothic

# YouTube 쿼터 보호 (units/일). 이 값을 넘으면 search.list를 차단한다.
YOUTUBE_DAILY_UNIT_LIMIT=8000

# 레퍼런스 영상 최대 길이(초). Shorts는 최대 180초까지 가능하지만 MVP 기본값은 60초.
REF_MAX_DURATION_SEC=60

# 웹 UI
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# 개발용: LLM만 Fake (Gemini 키 없이 UI 개발). 운영에서는 false
DEV_FAKE_LLM=false

# 런타임 데이터 위치
DATA_DIR=./data
