# 비밀값
# API 키가 들어 있는 설정 파일과 그 사본(.env.old.txt, .env.bak 등). 템플릿만 올린다
.env
.env*
**/.env*
!.env.example
!**/.env.example
*.env.local

# 런타임 데이터 (프로젝트, 캐시, 렌더 결과)
shortforge/data/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
.next/

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 브라우저 자동화 스크린샷·로그
.playwright-mcp/

# 화면 자동 테스트(Playwright) 결과
/shortforge/frontend/test-results/
/shortforge/frontend/playwright-report/

